# 1. Opciones Globales de R
options(
  repos = c(CRAN = "https://cloud.r-project.org/"),
  encoding = "UTF-8",
  width = 100,
  digits = 5,
  scipen = 999,
  warnPartialMatchArgs = TRUE,
  warnPartialMatchAttr = TRUE,
  warnPartialMatchDollar = TRUE,
  show.signif.stars = TRUE
)

# 2. Banner de Inicio en RStudio
if (interactive()) {
  message("----------------------------------------------------------------------")
  message("  🧬 BioAgro-Stats: Suite Estadística para Biotecnología y Agronomía ")
  message("  Autor: Paul Alexander López Peña (PUC Chile)                       ")
  message("----------------------------------------------------------------------")
  message("  📚 Módulos Disponibles en el Repositorio:")
  message("    📁 01_Exploracion_Supuestos       -> Diagnóstico (Normalidad, Homocedasticidad, VIF)")
  message("    📁 02_Diseno_Experimental        -> DBCA, Alpha-Lattice, Split-Plot, Cuadrado Latino")
  message("    📁 03_Modelos_Frecuentistas       -> ANOVA, GLM, LMM y Medidas Repetidas")
  message("    📁 04_Modelos_No_Lineales_y_GAMs  -> GAMs y Curvas Dosis-Respuesta (drc / LL.4)")
  message("    📁 05_Estadistica_Bayesiana       -> brms, MCMC, GxE y Curvas de Crecimiento")
  message("    📁 06_Machine_Learning            -> tidymodels, Random Forest, XGBoost y SVM")
  message("    📁 07_Multivariado_y_Omicas       -> PCA Biplots, PERMANOVA, sPLS-DA y Heatmaps")
  message("    📁 08_Reportes_Quarto             -> Plantillas y reportes reproducibles (.qmd)")
  message("----------------------------------------------------------------------\n")
}
